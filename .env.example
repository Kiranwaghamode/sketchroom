# Each app reads its own .env file:
#   packages/db/.env   -> DATABASE_URL (Prisma CLI: migrate, studio)
#   apps/web/.env      -> shared + web variables
#   apps/sync/.env     -> shared + sync variables

# shared
DATABASE_URL=postgresql://...
WS_JWT_SECRET=long-random-string        # same value in web and sync

# web
BETTER_AUTH_SECRET=long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234

# sync
PORT=1234
ALLOWED_ORIGIN=http://localhost:3000
