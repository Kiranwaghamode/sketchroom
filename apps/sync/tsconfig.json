{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    // Production runs the TypeScript directly with Node's type stripping
    // (`node src/index.ts`), so only syntax Node can erase is allowed.
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src"]
}
